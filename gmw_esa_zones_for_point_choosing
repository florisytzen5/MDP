/**********************************************************************
 * SISAL — GMW v4.1 ANNUAL TRAJECTORY CLASSIFICATION
 *
 * Global Mangrove Watch v4.1.12, 41 annual epochs 1985-2025.
 * DN 1 = mangrove, DN 0 = non-mangrove.
 *
 * Replaces the v3 eleven-epoch version. What changes:
 *   - No epoch weighting. All intervals are 1 year, so the raw count
 *     is already unbiased and EPOCH_WEIGHTS is gone.
 *   - Transition years are exact, not five-year windows.
 *   - Pre-transition record length becomes computable, which is the
 *     filter that decides whether a loss pixel is usable as a positive
 *     case for temporal early-warning analysis at all.
 *   - flips over 41 observations is a usable noise metric.
 *
 * Point selection deliberately not included — settle the map first.
 *********************************************************************/


/*====================================================================
 * 0. CONFIG
 *===================================================================*/

var GMW_ASSET = 'projects/ee-florisytzen/assets/gmw_v41_sisal';

var FIRST_YEAR = 1985;
var LAST_YEAR  = 2025;

var PROJ       = 'EPSG:32615';   // UTM 15N
var GRID_SCALE = 25;             // set from gdalinfo Pixel Size

// How far inside a stable patch a pixel must sit to count as interior.
// Must exceed the product's boundary uncertainty, not be chosen for
// looks. Run at 60, 100 and 150 and watch how much interior survives;
// if it collapses at 150 the AOI has no patches large enough to
// support a defensible control class, which is a finding.
var EDGE_BUFFER = 100;           // metres

// Minimum years of record BEFORE a transition for that pixel to be
// usable as a temporal early-warning case. A rolling window of width w
// needs at least w observations before the event, plus enough beyond
// it to see the indicator turn over. 15 is a starting point, not a
// standard — set it from the window length you actually intend to use.
var MIN_PRE_YEARS  = 15;
var MIN_POST_YEARS = 3;

// Isolated single pixels are classification error far more often than
// real events. Raising this buys cleaner cases and fewer of them, at
// the cost of genuine small-scale mortality.
var MIN_PATCH_PIX = 4;           // at 25 m, ~0.25 ha

var aoi = ee.Geometry.Polygon(
  [[[-90.05041551503234, 21.162924684073946],
    [-90.09495298591237, 21.158981726153797],
    [-90.12053053107839, 21.141531063671124],
    [-90.12018720832448, 21.078595563619460],
    [-90.05066435065847, 21.078497576643580],
    [-89.93977110114675, 21.113251544607984],
    [-89.93925611701589, 21.213143836734320],
    [-90.00933715735849, 21.174100452704874],
    [-90.00920841132577, 21.168337747312170],
    [-90.01991318489279, 21.164856004032620],
    [-90.03102825905050, 21.162574817466144],
    [-90.03858135963644, 21.161774392793973],
    [-90.04819439674581, 21.159733290287747],
    [-90.05016850258077, 21.165816493119890]]]);
var AOI = aoi;

Map.centerObject(AOI, 12);
Map.setOptions('SATELLITE');


/*====================================================================
 * 1. LOAD AND NORMALISE
 *===================================================================*/
var YEARS = [];
for (var y = FIRST_YEAR; y <= LAST_YEAR; y++) { YEARS.push(y); }
var nY = YEARS.length;

var bandNames = YEARS.map(function (yr) { return 'y' + yr; });
var rawBands  = YEARS.map(function (yr, i) { return 'b' + (i + 1); });

var GMW_TILE_A = 'projects/ee-florisytzen/assets/gmw_v41_N22W090';
var GMW_TILE_B = 'projects/ee-florisytzen/assets/gmw_v41_N22W091';

var tiles = ee.ImageCollection([
  ee.Image(GMW_TILE_A),
  ee.Image(GMW_TILE_B)
]);

var stack = tiles.mosaic()
  .select(rawBands, bandNames)
  .unmask(0).gt(0).byte()
  .reproject({crs: PROJ, scale: GRID_SCALE})
  .clip(AOI);

print('--- Load check ---');
print('Tile A bands:', ee.Image(GMW_TILE_A).bandNames());
print('Tile B bands:', ee.Image(GMW_TILE_B).bandNames());
print('Years:', nY, FIRST_YEAR + '-' + LAST_YEAR);

/*====================================================================
 * 2. DERIVED METRICS
 *===================================================================*/

// Persistence: fraction of the 41 years mapped as mangrove.
// With annual data this needs no weighting.
var nYears = stack.reduce(ee.Reducer.sum()).rename('n_years');
var persist = nYears.divide(nY).rename('persist');

// Turnover. Over 41 annual observations this is a genuine noise
// metric: real ecological change gives 1-2, speckle gives 10+.
var flips = ee.Image(0);
for (var i = 1; i < nY; i++) {
  flips = flips.add(stack.select(bandNames[i]).neq(stack.select(bandNames[i - 1])));
}
flips = flips.rename('flips');

// First and last year present, as calendar years.
var idxImages = YEARS.map(function (yr, k) {
  return ee.Image.constant(k).int16()
    .updateMask(stack.select('y' + yr).eq(1)).rename('idx');
});
var firstIdx = ee.ImageCollection(idxImages).min();
var lastIdx  = ee.ImageCollection(idxImages).max();
var firstYr = firstIdx.add(FIRST_YEAR).rename('first_year');
var lastYr  = lastIdx.add(FIRST_YEAR).rename('last_year');

// Longest unbroken run of mangrove years. Distinguishes 30 consecutive
// years from 30 scattered ones — identical persistence, entirely
// different stability.
var runAcc = ee.Dictionary(ee.List(bandNames).iterate(function (bn, acc) {
  acc = ee.Dictionary(acc);
  var cur = ee.Image(acc.get('cur'));
  var mx  = ee.Image(acc.get('max'));
  var b   = stack.select(ee.String(bn));
  var newCur = cur.add(1).multiply(b);   // resets to 0 on a 0 year
  return ee.Dictionary({cur: newCur, max: mx.max(newCur)});
}, ee.Dictionary({cur: ee.Image(0), max: ee.Image(0)})));
var longestRun = ee.Image(runAcc.get('max')).rename('longest_run')
  .reproject({crs: PROJ, scale: GRID_SCALE});


/*====================================================================
 * 3. TRAJECTORY CLASSIFICATION
 *===================================================================*/

var firstEp = stack.select(bandNames[0]);        // 1985
var lastEp  = stack.select(bandNames[nY - 1]);   // 2025
var ever    = nYears.gt(0);
var always  = nYears.eq(nY);

// Interior vs edge, among always-mangrove pixels.
var interior       = always.focal_min({radius: EDGE_BUFFER, units: 'meters'});
var stableInterior = always.and(interior);
var stableEdge     = always.and(interior.not());

// Single transitions.
var lossMono = firstEp.eq(1).and(lastEp.eq(0)).and(flips.eq(1));
var gainMono = firstEp.eq(0).and(lastEp.eq(1)).and(flips.eq(1));

// Two transitions — now separable, where 11 epochs collapsed them
// into one ambiguous bin.
var lossRecover = firstEp.eq(1).and(lastEp.eq(1)).and(flips.eq(2));
var gainLoss    = firstEp.eq(0).and(lastEp.eq(0)).and(flips.eq(2));

var noisy = ever.and(flips.gte(3));

// Transition year for single-loss pixels: the first year absent.
var lossYear = lastYr.add(1).updateMask(lossMono).rename('loss_year');
var preYears  = lossYear.subtract(FIRST_YEAR).rename('pre_years');
var postYears = ee.Image.constant(LAST_YEAR).subtract(lossYear).rename('post_years');

// Loss cases with enough record on both sides of the event to support
// a rolling-window indicator. This filter is the main thing the annual
// product makes possible, and it will remove a real share of the
// apparent loss class.
var lossUsable = lossMono
  .and(preYears.gte(MIN_PRE_YEARS))
  .and(postYears.gte(MIN_POST_YEARS));
var lossTooEarly = lossMono.and(lossUsable.not());

// 1 stable interior | 2 stable edge | 3 loss (usable)
// 4 loss (insufficient record) | 5 gain | 6 loss-then-recovery
// 7 gain-then-loss | 8 noisy
var traj = ee.Image(0)
  .where(stableInterior, 1)
  .where(stableEdge, 2)
  .where(lossUsable, 3)
  .where(lossTooEarly, 4)
  .where(gainMono, 5)
  .where(lossRecover, 6)
  .where(gainLoss, 7)
  .where(noisy, 8)
  .rename('traj').selfMask()
  .reproject({crs: PROJ, scale: GRID_SCALE})
  .clip(AOI);

var trajClean = traj.updateMask(
  traj.connectedPixelCount(64, false).gte(MIN_PATCH_PIX));


/*====================================================================
 * 4. NUMBERS
 *===================================================================*/

function areaByClass(img, label) {
  print(label, ee.Image.pixelArea().divide(1e4).addBands(img).reduceRegion({
    reducer: ee.Reducer.sum().group({groupField: 1, groupName: 'traj'}),
    geometry: AOI, scale: GRID_SCALE, crs: PROJ,
    maxPixels: 1e13, tileScale: 4
  }).get('groups'));
}

print('--- Trajectory classes (ha) ---');
print('1 interior | 2 edge | 3 loss usable | 4 loss too early |',
      '5 gain | 6 loss-recover | 7 gain-loss | 8 noisy');
areaByClass(traj,      'Before contiguity filter:');
areaByClass(trajClean, 'After contiguity filter:');

// Compare the two: the gap is single-pixel speckle. If class 3 halves,
// most of the apparent loss was noise.

// Annual extent. A step change between consecutive years that is large
// relative to neighbouring years points at a methodology break in the
// product rather than at the mangrove.
// One aggregation over all 41 bands instead of 41 separate ones.
// reduceRegion on a multiband image returns a dictionary keyed by
// band name, so the per-year loop happens on the dictionary, not on
// the server.
var areaDict = ee.Dictionary(
  stack.multiply(ee.Image.pixelArea()).divide(1e4)
    .reduceRegion({
      reducer: ee.Reducer.sum(), geometry: AOI,
      scale: GRID_SCALE, crs: PROJ, maxPixels: 1e13, tileScale: 4
    }));

var extentFc = ee.FeatureCollection(
  ee.List(bandNames).map(function (bn) {
    var i = ee.List(bandNames).indexOf(bn);
    return ee.Feature(null, {
      year: ee.Number(FIRST_YEAR).add(i),
      area_ha: areaDict.get(bn)
    });
  }));

print(ui.Chart.feature.byFeature(extentFc, 'year', ['area_ha'])
  .setChartType('LineChart')
  .setOptions({
    title: 'GMW v4.1 mangrove area within AOI, 1985-2025',
    hAxis: {title: 'Year', format: '####'},
    vAxis: {title: 'Hectares'},
    pointSize: 3, lineWidth: 1
  }));

// When do losses occur? A flat spread suggests turnover; clusters
// suggest events worth matching against hurricane or development
// records.
print(ui.Chart.image.histogram({
  image: lossYear.updateMask(lossUsable),
  region: AOI, scale: GRID_SCALE, maxBuckets: 41
}).setOptions({
  title: 'Loss year distribution (usable cases only)',
  hAxis: {title: 'Year'}, vAxis: {title: 'Pixels'}
}));


/*====================================================================
 * 5. MAP
 *===================================================================*/

var trajPalette = [
  '12301f',  // 1 stable interior
  '9fbf6a',  // 2 stable edge
  'e31a1c',  // 3 loss, usable
  '8c2d04',  // 4 loss, insufficient record
  '1f78b4',  // 5 gain
  'ff7f00',  // 6 loss then recovery
  '6a3d9a',  // 7 gain then loss
  'e000ff'   // 8 noisy
];

Map.addLayer(trajClean, {min: 1, max: 8, palette: trajPalette},
  'Trajectory class (filtered)', true);
Map.addLayer(traj, {min: 1, max: 8, palette: trajPalette},
  'Trajectory class (unfiltered)', false);

Map.addLayer(persist.selfMask(), {
  min: 0.05, max: 1,
  palette: ['f2d9c4', 'd4b483', '9fbf6a', '3d7a37', '12301f']
}, 'Persistence (fraction of 41 yr)', false);

Map.addLayer(longestRun.selfMask(), {
  min: 1, max: nY,
  palette: ['f2d9c4', 'd4b483', '9fbf6a', '3d7a37', '12301f']
}, 'Longest unbroken run (yr)', false);

Map.addLayer(flips.updateMask(ever), {
  min: 0, max: 10, palette: ['ffffff', 'fee08b', 'f46d43', 'a50026']
}, 'Turnover (state changes)', false);

Map.addLayer(lossYear.updateMask(lossUsable), {
  min: FIRST_YEAR, max: LAST_YEAR,
  palette: ['fde725', '5ec962', '21918c', '3b528b', '440154']
}, 'Loss year (usable cases)', false);

Map.addLayer(ee.Image().paint(AOI, 0, 2), {palette: 'yellow'}, 'AOI', false);


/*====================================================================
 * 6. LEGENDS
 *===================================================================*/

function addCategoricalLegend(title, items, position) {
  var legend = ui.Panel({
    style: {position: position || 'bottom-left', padding: '8px 15px'}
  });
  legend.add(ui.Label({
    value: title,
    style: {fontWeight: 'bold', fontSize: '13px', margin: '0 0 6px 0'}
  }));
  items.forEach(function (item) {
    legend.add(ui.Panel({
      widgets: [
        ui.Label({style: {backgroundColor: item.color, padding: '8px',
                          margin: '0 0 4px 0'}}),
        ui.Label({value: item.label, style: {margin: '0 0 4px 6px'}})
      ],
      layout: ui.Panel.Layout.Flow('horizontal')
    }));
  });
  Map.add(legend);
}

addCategoricalLegend('Trajectory class (GMW v4.1, 1985-2025)', [
  {color: '#12301f', label: '1 Stable interior (control)'},
  {color: '#9fbf6a', label: '2 Stable edge'},
  {color: '#e31a1c', label: '3 Loss — usable case'},
  {color: '#8c2d04', label: '4 Loss — too little record'},
  {color: '#1f78b4', label: '5 Gain'},
  {color: '#ff7f00', label: '6 Loss then recovery'},
  {color: '#6a3d9a', label: '7 Gain then loss'},
  {color: '#e000ff', label: '8 Noisy (3+ changes)'}
], 'bottom-left');
