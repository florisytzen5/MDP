// than eyeballing rind thickness.
//
// Insensitivity here means patches are large relative to the buffer,
// not that the parameter is harmless. Whether the control class is
// actually contaminated is a question for the NDVI series, not this
// layer.
if (SWEEP === 'edge') {
  print('=== STEP 4: EDGE_BUFFER sweep ===');
  EDGE_VALUES.forEach(function (b) {
    var r = buildTraj(MIN_DURATION, K, MIN_PATCH_PIX, b);
    print('EDGE_BUFFER = ' + b + ' m', classAreas(r.clean));
  });
}

