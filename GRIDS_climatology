//=== Annual mean ERA5 SST offshore Sisal =====================================
var BOX   = ee.Geometry.Rectangle([-90.30, 21.30, -89.80, 21.70]);
var YEARS = ee.List.sequence(1995, 2024);

var era5Daily = ee.ImageCollection('ECMWF/ERA5/HOURLY')
  .select(ERA5_SST)
  .filter(ee.Filter.calendarRange(12, 12, 'hour'));

var annualFc = ee.FeatureCollection(YEARS.map(function (year) {
  year = ee.Number(year);
  var t0 = ee.Date.fromYMD(year, 1, 1), t1 = t0.advance(1, 'year');
  var e = era5Daily.filterDate(t0, t1).mean().subtract(273.15)
            .reduceRegion({reducer: ee.Reducer.mean(), geometry: BOX,
                           scale: 27830, maxPixels: 1e9}).get(ERA5_SST);
  return ee.Feature(null, {year: year, ERA5_SST: e});
}));

print(ui.Chart.feature.byFeature(annualFc, 'year', ['ERA5_SST'])
  .setChartType('LineChart')
  .setOptions({title: 'ERA5 annual mean SST offshore Sisal',
               hAxis: {title: 'Year', format: '####'},
               vAxis: {title: 'SST (C)'}, lineWidth: 2, pointSize: 3}));

