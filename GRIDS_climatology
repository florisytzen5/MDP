var TEMP_PAL = ['2c7bb6', 'abd9e9', 'ffffbf', 'fdae61', 'd7191c'];

//=== Grid builder (offset = where cell EDGES fall) ===========================
function gridCells(res, offset, region) {
  var b  = ee.List(region.bounds().coordinates().get(0));
  var xs = b.map(function (p) { return ee.List(p).get(0); });
  var ys = b.map(function (p) { return ee.List(p).get(1); });

  function edges(minV, maxV) {
    var k0 = ee.Number(minV).subtract(offset).divide(res).floor();
    var k1 = ee.Number(maxV).subtract(offset).divide(res).ceil();
    return ee.List.sequence(k0, k1).map(function (k) {
      return ee.Number(k).multiply(res).add(offset);
    });
  }

  var xE = edges(xs.reduce(ee.Reducer.min()), xs.reduce(ee.Reducer.max()));
  var yE = edges(ys.reduce(ee.Reducer.min()), ys.reduce(ee.Reducer.max()));

  return ee.FeatureCollection(
    ee.List.sequence(0, xE.size().subtract(2)).map(function (i) {
      var x0 = ee.Number(xE.get(ee.Number(i)));
      var x1 = ee.Number(xE.get(ee.Number(i).add(1)));
      return ee.List.sequence(0, yE.size().subtract(2)).map(function (j) {
        var y0 = ee.Number(yE.get(ee.Number(j)));
        var y1 = ee.Number(yE.get(ee.Number(j).add(1)));
        var g  = ee.Geometry.Rectangle(ee.List([x0, y0, x1, y1]), null, false);
        return ee.Feature(g, {area_km2: g.area(1).divide(1e6)});
      });
    }).flatten()
  );
}

var gEra5 = gridCells(0.25, 0.125, GRIDZONE);
var gLand = gridCells(0.10, 0.05,  GRIDZONE);

