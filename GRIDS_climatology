function legendRow(color, text) {
  var lbl = ui.Label(text, {margin: '0 0 4px 0', fontSize: '13px'});
  legend.add(ui.Panel({
    widgets: [ui.Label('', {backgroundColor: color, padding: '9px',
                            margin: '0 8px 4px 0', border: '1px solid #444'}), lbl],
    layout: ui.Panel.Layout.Flow('horizontal')}));
  return lbl;
}

var lblEra5 = legendRow('red',     'ERA5  0.25 deg');
var lblLand = legendRow('orange',  'ERA5-Land  0.1 deg');
var lblAOI  = legendRow('#00008B', 'AOI');

function fillArea(lbl, fc, prefix) {
  ee.Feature(fc.first()).get('area_km2').evaluate(function (v) {
    lbl.setValue(prefix + '  (' + v.toFixed(0) + ' km2 per cell)');
  });
}
fillArea(lblEra5, gEra5, 'ERA5  0.25 deg');
fillArea(lblLand, gLand, 'ERA5-Land  0.1 deg');
AOI.area(1).divide(1e6).evaluate(function (v) {
